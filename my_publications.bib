@article{Fazzini2026,
   abstract = {In many multi-channel engineering problems, the information relevant to the task is concentrated in one channel, while the other information plays an auxiliary role. In forecasting, the quantity to be predicted is the primary source of information and the covariates support it; in image processing, the image itself is primary and contextual data are auxiliary. This paper introduces multi-channel neighborhood-constrained variational mode decomposition (NCVMD), an extension of variational mode decomposition (VMD) built on this hierarchy. Where multivariate VMD (MVMD) aligns the modes’ central frequencies symmetrically and exactly across all channels, NCVMD distinguishes a main channel from auxiliary ones and makes the degree of alignment tunable, reallocating the decomposition error away from the priority channel by a controllable amount. A second contribution is a formal analysis of the resulting optimization problem, which delimits what can be asserted and what cannot. Every subproblem of the alternating scheme is convex and admits a unique closed-form solution, and the main channel provably attains the unconstrained VMD optimum, which MVMD cannot. The joint problem, however, remains nonconvex, so global optimality is not guaranteed. Experiments on synthetic and real-world data confirm the predicted behaviour.},
   author = {Paolo Fazzini and Giuseppe La Tona and Matteo Diez and Marco Montuori and Maria Carmela Di Piazza},
   doi = {10.3390/info17100970},
   issn = {2078-2489},
   issue = {10},
   journal = {Information},
   month = {10},
   pages = {970},
   title = {Multi-Channel Neighborhood-Constrained Variational Mode Decomposition},
   volume = {17},
   url = {https://www.mdpi.com/2078-2489/17/10/970},
   year = {2026}
}
@article{Fazzini2025,
   abstract = {This paper introduces Multi-Channel Neighborhood-Constrained Variational Mode Decomposition (NCVMD), a novel extension of Variational Mode Decomposition (VMD). When working with multi-channel signals, aligning mode frequencies serves as a criterion for grouping modes with similar frequencies and enabling mode-level processing. This requirement must be achieved while maintaining an acceptable error in the decomposition, and has been investigated by an approach called Multivariate Variational Mode Decomposition (MVMD), which forces a perfect alignment of the channels' modes' central frequencies at the expense of the decomposition error. Our approach differs in two key ways: first, by making a hierarchical distinction in a multi-channel signal between a primary (main) channel and others that provide auxiliary information; and second, by allowing tunable alignment between channel decomposition. Both these aspects reduce the decomposition error in the main channel at the expense of the auxiliary channels, at a customizable degree. These distinctive features make the method particularly well-suited for applications such as weighted image fusion, signal denoising, and time series forecasting; in these domains, there are clear advantages to both establishing a hierarchical processing framework for the signal's channels and operating at mode level, where intrinsic oscillatory patterns can be extracted and processed independently. We demonstrate the effectiveness of NCVMD through experiments on both synthetic and real-world datasets. The results indicate that NCVMD preserves a pure VMD-based decomposition for the main channel, maintains acceptable decomposition errors for the auxiliary channels, and achieves a high degree of mode frequency alignment across channels.},
   author = {Paolo Fazzini and Giuseppe La Tona and Matteo Diez and Marco Montuori and Maria Carmela Di Piazza},
   doi = {10.36227/techrxiv.175382744.48114248/v1},
   issue = {0729},
   journal = {TechRxiv},
   title = {Multi-Channel Neighborhood-Constrained Variational Mode Decomposition},
   volume = {2025},
   url = {https://www.techrxiv.org/doi/abs/10.36227/techrxiv.175382744.48114248/v1},
   year = {2025}
}
